{
  "name": "Baseline",
  "_note": "Reference config: MHA + LayerNorm + dense SwiGLU. All contrast configs differ from this in exactly one swap axis.",
  "arch": {
    "d_model": 128,
    "n_layers": 4,
    "n_heads": 8,
    "n_kv_heads": 8,
    "head_dim": 16,
    "ctx": 128,
    "norm": "layernorm",
    "ffn": "dense",
    "ffn_mult": 4,
    "tie_embeddings": true
  },
  "train": {
    "seed": 1337,
    "lr": 3e-4,
    "batch_size": 64,
    "steps": 3000,
    "warmup_steps": 100,
    "eval_interval": 250,
    "eval_iters": 40,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "dataset_path": "data/tinystories.txt",
    "device": "auto"
  }
}